# Base URL of the SmartTrip API, including the /api/v1 prefix.
#
#   iOS simulator / web :  http://localhost:4000/api/v1
#   Android emulator     :  http://10.0.2.2:4000/api/v1
#   Physical device      :  http://<your-computer-LAN-IP>:4000/api/v1
#
# On a physical device use your machine's LAN IP (e.g. ipconfig -> IPv4 Address),
# and make sure the phone is on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Android only. Required for react-native-maps to render Google Maps.
GOOGLE_MAPS_API_KEY=
