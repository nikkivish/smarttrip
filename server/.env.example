# --- Server ---
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Use your Neon pooled URL in production (add ?sslmode=require
# for hosted providers that require TLS).
DATABASE_URL="postgresql://user:password@localhost:5432/smarttrip?sslmode=disable"

# Optional. Prisma CLI commands (migrate, studio) need a direct connection because Neon
# pools in transaction mode. Set this to Neon's direct URL in production.
# DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/smarttrip?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires a real value of 32+ characters; the placeholder is rejected.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Only needed if you serve the mobile app from a deployed web build. The frontend
# build variable EXPO_PUBLIC_API_URL must match the deployed API origin.
CORS_ORIGIN=*

# --- AI (optional) ---
# Leave blank to use the built-in mock generator, so the app works with no keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Safety alerts (optional) ---
# Without these, SOS alerts are logged server-side but not texted.
# For Indian numbers you likely want an India-compliant provider such as MSG91.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
